    },
    "Pair your Mac once in Dewlet. After that it appears right here when you share.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair your Mac once in Dewlet. After that it appears right here when you share."
          }
