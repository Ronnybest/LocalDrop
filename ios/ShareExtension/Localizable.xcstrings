    },
    "Add your Mac first": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your Mac first"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте Mac"
