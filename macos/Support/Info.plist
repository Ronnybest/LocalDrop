<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LocalDropAppGroup</key>
	<string>$(TeamIdentifierPrefix)com.zepponapps.localdrop</string>
	<!-- Only standard encryption (CryptoKit's AES-GCM, ECDH, ECDSA) to protect the user's own
	     transfers: exempt from US export documentation, so App Store Connect needn't ask. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSFileQuarantineEnabled</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_localdrop._tcp</string>
	</array>
</dict>
</plist>
