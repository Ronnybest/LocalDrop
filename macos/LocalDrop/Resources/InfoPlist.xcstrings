    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dewlet uses Bluetooth so that your paired phone can find this Mac nearby. For example, when you share a photo on your phone, this Mac shows up as a destination right away."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dewlet использует Bluetooth, чтобы привязанный телефон находил этот Mac рядом. Например, когда вы делитесь фото на телефоне, этот Mac сразу появляется среди получателей."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dewlet sends and receives files directly between this Mac and your paired phone over the local network. For example, a video you share from your phone arrives over your Wi-Fi without going through the internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dewlet передаёт файлы напрямую между этим Mac и привязанным телефоном по локальной сети. Например, видео, которым вы поделились с телефона, приходит по Wi-Fi, минуя интернет."
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription" : {
      "comment" : "Privacy - Downloads Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dewlet saves the files you send from your phone to your Downloads folder. For example, a photo you share from your phone to this Mac appears in Downloads."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dewlet сохраняет в папку «Загрузки» файлы, которые вы отправляете с телефона. Например, фото, которым вы поделились с телефона на этот Mac, появится в «Загрузках»."
          }
        }
      }
    }
  },
  "version" : "1.0"
}