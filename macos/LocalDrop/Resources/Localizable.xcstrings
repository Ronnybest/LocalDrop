      }
    },
    "Everything": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё"
          }
        }
      }
    },
    "Files arrive at only a few MB/s on this network. A 5 GHz network — or your phone's 5 GHz hotspot — is many times faster.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой сети файлы идут со скоростью всего несколько МБ/с. Сеть 5 ГГц — или точка доступа телефона на 5 ГГц — во много раз быстрее."
          }
        }
      }
    },
    "Files received with LocalDrop will be saved in this folder.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы, полученные через LocalDrop, будут сохраняться в эту папку."
          }
        }
      }
    },
    "Files under 100 MB": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы до 100 МБ"
          }
        }
      }
    },
    "Folder unavailable — saving to Downloads until it's back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка недоступна — пока она не вернётся, файлы сохраняются в «Загрузки»."
          }
        }
      }
    },
    "For 10 minutes, phones that aren't paired yet can find this Mac.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В течение 10 минут ещё не привязанные телефоны смогут найти этот Mac."
          }
        }
      }
    },
