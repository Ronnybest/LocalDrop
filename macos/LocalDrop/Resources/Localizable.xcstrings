{
  "sourceLanguage": "en",
  "strings": {
    "%@ — retrying": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — повторная попытка"
          }
        }
      }
    },
    "%@ cancelled the transfer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отменил передачу"
          }
        }
      }
    },
    "%@ didn't take the files": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не принял файлы"
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ из %2$@"
          }
        }
      }
    },
    "%@ received": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ получен"
          }
        }
      }
    },
    "%@ tried to send %@, but there isn't enough disk space": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ пытался отправить %2$@, но на диске недостаточно места"
          }
        }
      }
    },
    "%@ was damaged in transit and was not saved": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ повреждён при передаче и не сохранён"
          }
        }
      }
    },
    "%@ will no longer be able to send to this Mac until it pairs again. A transfer in progress stops.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ больше не сможет отправлять на этот Mac, пока не будет привязан снова. Текущая передача остановится."
          }
        }
      }
    },
    "%@/s": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/с"
          }
        }
      }
    },
