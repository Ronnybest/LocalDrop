    "%lld%% · %@ of %@": {
      "extractionState": "stale",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld%% · %2$@ из %3$@"
          }
        }
      }
    },
    "A new phone pairs once, after both screens show the same code. Paired devices find this Mac without it being visible.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый телефон привязывается один раз — после того как на обоих экранах совпадёт код. Привязанные устройства находят этот Mac и без видимости."
          }
        }
      }
    },
    "Accept": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять"
          }
        }
      }
    },
    "All Devices": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все устройства"
          }
        }
      }
    },
    "All good": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё в порядке"
          }
        }
      }
    },
    "Allow LocalDrop in System Settings › General › Login Items.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите LocalDrop в Системных настройках › Основные › Объекты входа."
          }
        }
      }
    },
    "Allow LocalDrop in System Settings › Privacy & Security › Bluetooth.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите LocalDrop в Системных настройках › Конфиденциальность и безопасность › Bluetooth."
          }
        }
      }
    },
    "Ask every time": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивать каждый раз"
