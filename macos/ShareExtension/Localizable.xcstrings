    "No phone can receive yet. Pair an Android phone with LocalDrop and open LocalDrop on it once.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No phone can receive yet. Pair an Android phone with LocalDrop and open LocalDrop on it once."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет телефона, который может принимать. Привяжите Android-телефон к LocalDrop и один раз откройте на нём LocalDrop."
          }
        }
      }
    },
    "The phone gets the files as soon as it's nearby, even if LocalDrop isn't open on it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
